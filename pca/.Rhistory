color = "grey80",          # all OTUs in light grey
pch = 19,
cex.symbols = 1.0,         # smaller grey dots
main = order_name,
xlab = "", ylab = "PC2", zlab = "PC3",
xlim = lims, ylim = lims, zlim = lims,
angle = 290,               #290 = PC2 in front, slightly tilted
box = TRUE,
cex.lab = 1.3,
cex.axis = 1.6,
cex.main = 2.5,
grid = TRUE)
#locate PC1 as text
# Choose a point near the x-axis, close to 0
coords <- s3d$xyz.convert(x = 0, y = max(lims) + 6, z = min(lims))
text(coords$x, coords$y,
labels = "PC1",
cex = 1.3,
srt = 290,      # rotation angle (match plot angle)
xpd = TRUE)
# Overlay selected OTUs in black
s3d$points3d(df_sel$x1, df_sel$x2, df_sel$x3,
col = "black", pch = 19, cex = 1)
# Add environmental vectors
for (i in 1:nrow(env_long)) {
arrow_col <- adjustcolor(env_long$col[i], alpha.f = 0.4)
with(env_long[i,],
s3d$points3d(c(0, x1), c(0, x2), c(0, x3),
type = "l", col = arrow_col, lwd = 3))
