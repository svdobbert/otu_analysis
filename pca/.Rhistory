#plot
group_colors <- c("AT" = "#c34426", "ST" = "#c87f3f", "SM" = "#408bbd")
env_long$col <- group_colors[env_long$Group]
# --- Determine fixed axis limits (so all plots share same scale) ---
lims <- c(-20, 20)
#empty caches
rm(plots, final_plot, tmpfile, ord, img)
gc()
# --- Function to create one 3D scatterplot for a single Order ---
make_3D_plot <- function(order_name) {
# Separate data
df_all <- otu_df  # all OTUs
df_sel <- otu_df %>% filter(Genus == order_name)                               #<- change here taxa level
if(nrow(df_sel) == 0) {
warning(paste("No data for genus", order_name))
return(NULL)
}
s3d <- scatterplot3d(df_all$x1, df_all$x2, df_all$x3,
color = "grey80",          # all OTUs in light grey
pch = 19,
cex.symbols = 1.0,         # smaller grey dots
main = order_name,
xlab = "", ylab = "PC2", zlab = "PC3",
xlim = lims, ylim = lims, zlim = lims,
angle = 290,               #290 = PC2 in front, slightly tilted
box = TRUE,
cex.lab = 1.3,
cex.axis = 1.6,
cex.main = 2.5,
grid = TRUE)
#locate PC1 as text
# Choose a point near the x-axis, close to 0
coords <- s3d$xyz.convert(x = 0, y = max(lims) + 6, z = min(lims))
text(coords$x, coords$y,
labels = "PC1",
cex = 1.3,
srt = 290,      # rotation angle (match plot angle)
xpd = TRUE)
# Overlay selected OTUs in black
s3d$points3d(df_sel$x1, df_sel$x2, df_sel$x3,
col = "black", pch = 19, cex = 2)
# Add environmental vectors
for (i in 1:nrow(env_long)) {
arrow_col <- adjustcolor(env_long$col[i], alpha.f = 0.4)
with(env_long[i,],
s3d$points3d(c(0, x1), c(0, x2), c(0, x3),
type = "l", col = arrow_col, lwd = 3))
text(s3d$xyz.convert(env_long$x1[i], env_long$x2[i], env_long$x3[i]),
labels = env_long$Variable[i],
pos = 3, cex = 1.5, col = arrow_col)
}
}
# --- Generate plots and combine ---
plots <- lapply(to_plot, function(ord) {
tmpfile <- tempfile(fileext = ".png")
png(tmpfile, width = 19, height = 26, units = "cm", res = 200)
make_3D_plot(ord)
dev.off()
magick::image_read(tmpfile)
})
